{
  "name": "2026-cyberlaw_tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.jsx",
  "scripts": {
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('fs');['dist/index.html'].forEach(p=>{const h=fs.readFileSync(p,'utf8');fs.writeFileSync(p,h.replace(/href=\\\"\\//g,'href=\\\"./').replace(/src=\\\"\\//g,'src=\\\"./'));});\"",
    "start": "vite --open",
    "start_public": "vite --open --host",
    "preview": "vite preview",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "login": "az login --service-principal -u $AZURE_USER -p $AZURE_PW --tenant $AZURE_TENANT",
    "push": "git push && git push unctad main",
    "sync-gh-pages": "git subtree push --prefix dist origin gh-pages",
    "sync-prod": "azcopy copy \"dist/*\" \"https://${AZURE_STORAGE_NAME}.blob.core.windows.net/\\$web/${npm_package_name}/\" --include-path 'js;css;assets' --recursive --exclude-pattern '.DS_Store'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "terser": "^5.0.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "highcharts": "^12.3.0",
    "react-is-visible": "^1.2.0",
    "react-select": "^5.10.2",
    "uuid4": "^2.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
